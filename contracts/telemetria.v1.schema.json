{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/telemetria.v1.schema.json",
  "title": "Mensagem canônica de telemetria — v1.0 (subconjunto do laboratório)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao",
    "id_mensagem",
    "dispositivo",
    "tipo",
    "timestamp",
    "medidas"
  ],
  "properties": {
    "versao": {
      "const": "1.0"
    },
    "id_mensagem": {
      "type": "string",
      "format": "uuid"
    },
    "dispositivo": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "const": "telemetria"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "via": {
      "type": "string"
    },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string"
        },
        "area": {
          "type": "string"
        },
        "geo": {
          "$ref": "#/$defs/geoPoint"
        }
      }
    },
    "medidas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grandeza",
          "valor",
          "unidade"
        ],
        "properties": {
          "grandeza": {
            "type": "string",
            "minLength": 1
          },
          "valor": {
            "type": "number"
          },
          "unidade": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false
        }
      }
    }
  }
}
